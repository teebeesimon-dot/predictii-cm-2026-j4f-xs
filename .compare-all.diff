+    <ul className="flex flex-col divide-y divide-border rounded-lg border border-border">
+      {matches.map((match) => (
+        <MatchRow
+          key={match.id}
+          match={match}
+          competition={edition.competitionId}
+          locked={scheduler.isLocked(match)}
